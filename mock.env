# Free test mode: no image API calls, no Stripe, nothing saved. `npm run dev:mock` loads this after .env.
IMAGE_PROVIDER=mock
MOCK_MIN_MS=3000
MOCK_MAX_MS=9000
# A share of picture checks fail on purpose, so the redraw loop and attempt counts can be seen.
MOCK_FAIL_RATE=0.2
DEV_LOGIN=1
# Empty on purpose: an in-memory database and a simulated checkout, so mock runs never touch real data.
DATABASE_URL=
STRIPE_SECRET_KEY=
