# Copy to .env for local development. .env is git-ignored; never commit real values.
OPENAI_API_KEY=
# Cheap default: gpt-image-2.5-flare at low quality.
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_QUALITY=low
IMAGES_PER_HOUR=30

# Google sign-in: an OAuth "Web application" client from Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. Any long random string.
SESSION_SECRET=
# Postgres (e.g. Neon). Leave empty to use an in-memory database that resets on restart.
DATABASE_URL=
# Shows a "Dev sign-in" link on localhost (ignored when NODE_ENV=production).
DEV_LOGIN=1
