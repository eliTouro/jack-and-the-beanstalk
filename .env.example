# Copy to .env for local development. .env is git-ignored; never commit real values.
OPENAI_API_KEY=
# Cheap default: gpt-image-2.5-flare at low quality.
IMAGE_MODEL=gpt-image-2.5-flare
IMAGE_QUALITY=low
# The small vision model that checks every picture.
ANALYSIS_MODEL=gpt-4.1-mini

# Stripe, TEST MODE ONLY: a key that starts with sk_test_. A live key is ignored.
# Never commit it: GitHub scans pushes for Stripe keys and Stripe revokes them.
STRIPE_SECRET_KEY=
# Optional: comma-separated emails that may process anyone's refund requests.
ADMIN_EMAILS=

# Lulu Print API, SANDBOX only (create an account at developers.sandbox.lulu.com).
# Leave empty to use the simulated printer.
LULU_CLIENT_KEY=
LULU_CLIENT_SECRET=
# Where Lulu sends questions about a print job (the shop owner, not the customer).
LULU_CONTACT_EMAIL=
# Price of a printed, shipped hardcover in cents (see WRITEUP.md).
PRINT_PRICE_CENTS=2899
# The imprint printed on the cover and copyright page.
PUBLISHER_NAME=Beanstalk Books

# Google sign-in: an OAuth "Web application" client from Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Signs the session cookie. Any long random string.
SESSION_SECRET=
# Postgres (e.g. Neon). Leave empty to use an in-memory database that resets on restart.
DATABASE_URL=
# Shows a "Dev sign-in" link on localhost (ignored when NODE_ENV=production).
DEV_LOGIN=1
