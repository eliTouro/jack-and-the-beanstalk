{
  "name": "jack-and-the-beanstalk",
  "version": "1.0.0",
  "description": "Upload a photo, get cartoonified, and star as Jack in two Jack and the Beanstalk scenes.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "try": "node --env-file-if-exists=.env scripts/try.mjs",
    "test": "node --test test/*.test.js",
    "dev:mock": "node --env-file-if-exists=.env --env-file=mock.env --watch server.js"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "cookie-session": "^2.1.1",
    "express": "^5.1.0",
    "google-auth-library": "^11.3.3",
    "openai": "^7.38.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0"
  }
}
