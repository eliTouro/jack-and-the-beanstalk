{
  "name": "jack-and-the-beanstalk",
  "version": "1.0.0",
  "description": "Upload a photo and your child becomes the hero of a 20-page picture book: Jack and the Beanstalk or Little Red Riding Hood.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "try": "node --env-file-if-exists=.env scripts/try.mjs",
    "test": "node --test test/*.test.js",
    "dev:mock": "node --env-file-if-exists=.env --env-file=mock.env --watch server.js",
    "dev:sandbox": "node --env-file-if-exists=.env --env-file=mock.env --env-file=sandbox.env --watch server.js",
    "pregen": "node --env-file-if-exists=.env scripts/pregen.mjs",
    "book": "node --env-file-if-exists=.env scripts/make-book.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "compression": "^1.8.2",
    "cookie-session": "^2.1.1",
    "express": "^5.1.0",
    "google-auth-library": "^11.3.3",
    "openai": "^7.38.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "sharp": "^0.35.5",
    "stripe": "^23.1.0"
  }
}
