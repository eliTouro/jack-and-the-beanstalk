{
  "name": "jack-and-the-beanstalk",
  "version": "1.0.0",
  "description": "Upload a photo, get cartoonified, and star as Jack in two Jack and the Beanstalk scenes.",
  "type": "module",
  "main": "server.js",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "try": "node --env-file-if-exists=.env scripts/try.mjs",
    "test": "node --test test/*.test.js"
  },
  "dependencies": {
    "express": "^5.1.0",
    "openai": "^7.38.0"
  }
}
